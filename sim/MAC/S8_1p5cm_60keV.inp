Paper 1 MCNPX Benchmark Geometry - Material S8 @ 60 keV, thickness 1.5 cm
Setup: Point Source @ 0 cm, Sample Position @ 50 cm, F4 Tally Mesh @ 70 cm

$OMP=1 

[ Parameters ]
icntl    = 0
nucdata  = 0
maxcas   = @PRIMARIES@
maxbch   = 1
file(6)  = phits_S8_1p5cm_60keV.out

[ Source ]
totfact  = 1.0
s-type   = 1
x0       = 0.0
y0       = 0.0
z0       = 0.0
z1       = 0.0
proj     = photon
e0       = 0.060000
dir      = all
r0       = 0.0

[ Material ]
m1    82000.00c  1.0     $ Pb (Lead)

m2    5000.00c    -0.13976
      8000.00c    -0.43837
      14000.00c   -0.04674
      20000.00c   -0.07147
      64000.00c   -0.30366

[ Surface ]
10  pz   0.0          $ Source position (z = 0 cm)
11  pz  10.0          $ Collimator front face (z = 10 cm)
12  pz  50.0          $ Collimator back face / Sample front face (z = 50 cm)
13  pz  51.5000       $ Sample back face (thickness 1.5 cm)
14  pz  45.0          $ Pb shield front face = collimator back face (z = 45 cm)
15  pz  70.0          $ F4 Tally detection field front face (z = 70 cm)
16  pz  72.0          $ F4 Tally detection field back face (z = 72 cm)
17  pz  75.0          $ Outer Pb shield back face (z = 75 cm)
18  pz  77.0          $ Back Pb cap behind detector (z = 75 to 77 cm)

20  cz   2.0          $ Collimator hole radius (r = 2.0 cm)
21  cz   3.0          $ Collimator outer radius (r = 3.0 cm)
22  cz   5.0          $ Glass sample radius (r = 5.0 cm)
25  cz  10.0          $ F4 detection field radius (r = 10.0 cm)
23  cz  13.0          $ Outer Pb shield inner radius (r = 13.0 cm)
24  cz  15.0          $ Outer Pb shield outer radius (r = 15.0 cm)
99  so 100.0          $ World boundary

[ Cell ]
$ Collimator bore (hole along z-axis)
101   0          11 -14 -20
$ Collimator Pb body
102   1 -11.34   11 -14 20 -21
$ Glass sample slot - S8 (rho = 4.4110 g/cm3)
103   2 -4.4110   12 -13 -22
$ F4 Tally Mesh detection field (z = 70 to 72 cm, r <= 10 cm)
104   0          15 -16 -25
$ Outer Pb shield (z = 45 to 75 cm, 13 <= r <= 15 cm)
105   1 -11.34   14 -17 23 -24
$ Back Pb cap behind detector (z = 75 to 77 cm, r <= 15 cm)
109   1 -11.34   17 -18 -24
$ Free chamber inside Pb shield (excluding collimator, sample, detector)
106   0          14 -17 -23  #101 #102 #103 #104
$ Space between source and collimator / shield
107   0          10 -14 -99  #101 #102
$ Surrounding space outside shield and collimator inside world
108   0          -99  #101 #102 #103 #104 #105 #106 #107 #109
$ Graveyard (outside world)
110  -1          99

[ Volume ]
reg   vol
104   628.3185

[ T-Track ]
title = Average Photon Flux in Detection Field (F4 equivalent) - S8 @ 60 keV
mesh  = reg
reg   = 104
part  = photon
unit  = 1
e-type = 2
ne    = 1
emin  = 0.0
emax  = 0.063000
axis  = reg
file  = track_S8_1p5cm_60keV.out

[ T-Track ]
title = Uncollided Peak Photon Flux in Detection Field - S8 @ 60 keV
mesh  = reg
reg   = 104
part  = photon
unit  = 1
e-type = 2
ne    = 1
emin  = 0.059400
emax  = 0.060600
axis  = reg
file  = peak_S8_1p5cm_60keV.out
